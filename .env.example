# Large language model API key.
# Example providers: DeepSeek official API, Paratera LLM API, or other OpenAI-compatible APIs.
DEEPSEEK_API_KEY=

# OpenAI-compatible base URL.
# Examples:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://llmapi.paratera.com/v1
DEEPSEEK_BASE_URL=

# Model name provided by your API provider.
# Examples:
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=DeepSeek-R1
# DEEPSEEK_MODEL=Qwen3-235B-A22B-Instruct-2507
DEEPSEEK_MODEL=

# Tavily API key for real web search.
TAVILY_API_KEY=

# Local SQLite database.
DATABASE_URL=sqlite:///./data/chongmingbird.db

# true = mock/demo mode, no API keys required
# false = real API mode, requires LLM API key and Tavily API key
DEMO_MODE=true
